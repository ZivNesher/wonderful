ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
BTS_SOCRATA_APP_TOKEN=

# Optional. Enables the /v1/chat/completions endpoint used as an ElevenLabs
# Conversational AI "Custom LLM" -- lets a real-time voice call use this exact
# agent as its brain. Any random secret works; put the same value into
# ElevenLabs' Agent config as the Custom LLM's Authorization header
# ("Bearer <this value>"). Leave blank to disable the endpoint (503).
VOICE_LLM_SHARED_SECRET=

# Optional, required together to enable the "Start voice call" button: an
# ElevenLabs API key with ElevenAgents "Write" permission, and the
# Conversational AI Agent ID (from ElevenLabs' dashboard, looks like
# agent_xxxxxxxxxxxx) that /voice-call/signed-url requests a short-lived
# session URL for.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
